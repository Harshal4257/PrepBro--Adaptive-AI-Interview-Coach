# Use "gemini" with your own Google AI Studio key, or "mock" for no-cost local testing.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.3
GOOGLE_API_KEY=

# Interview behavior
MAX_QUESTIONS=8
INITIAL_DIFFICULTY=Easy
MINIMUM_SCORE_THRESHOLD=6.0
MAX_QUERY_LENGTH=12000
MAX_ANSWER_LENGTH=6000
MAX_OUTPUT_TOKENS=700

# Reliability and application settings
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LOG_LEVEL=INFO
APP_ENV=development

# UI/API configuration
API_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
